{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trackdraw-designer",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "designer.trackdraw.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
