{
  "name": "track-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:multigp:extract": "node scripts/extract_glb_textures.mjs",
    "assets:multigp:optimize": "node scripts/optimize_multigp_textures.mjs",
    "assets:multigp:refresh": "npm run assets:multigp:extract && npm run assets:multigp:optimize",
    "test": "node --test",
    "assets:upload": "node scripts/upload-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:check": "node scripts/check-collections.mjs",
    "textures:build": "node scripts/build.mjs",
    "textures:preview": "node scripts/preview.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "designer:dev": "npm run dev --workspace designer/app",
    "designer:build": "npm run build --workspace designer/app",
    "designer:test": "npm run designer:build && node --test designer/app/e2e/designer.spec.mjs"
  },
  "devDependencies": {
    "@trackdraw/viewer": "1.0.4",
    "@types/node": "26.6.4",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "workspaces": [
    "designer/core",
    "designer/app"
  ]
}
