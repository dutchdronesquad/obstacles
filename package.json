{
  "name": "track-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:multigp:extract": "node scripts/extract_glb_textures.mjs",
